{
  "name": "image-annotation-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Offline-first image annotations in one HTML file",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "test:e2e": "python -m unittest discover -s tests/e2e -p 'test_*.py' -v",
    "check": "npm run build && npm test && npm run test:e2e",
    "test:smoke": "python -m unittest discover -s tests/smoke -p 'test_*.py' -v"
  },
  "license": "MIT"
}
